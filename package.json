{
  "name": "@pamfilico/design-core",
  "version": "0.1.0",
  "description": "Shared, theme-driven design-system components used across Pamfilico apps. Brand-agnostic — styled entirely by the host app's MUI theme.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "@mui/material": ">=5",
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "react": "^19.0.0",
    "@types/react": "^19.0.0",
    "@mui/material": "^7.3.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0"
  },
  "author": "Pamfilico",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pamfilico/design-core.git"
  }
}
